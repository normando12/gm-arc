# Arc mainnet ArcGM (deployed)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x605A1Adc99796C5A1AB059386EBBE533Dc9d22e3

# Optional alias for the same address
# NEXT_PUBLIC_GM_CONTRACT=0x605A1Adc99796C5A1AB059386EBBE533Dc9d22e3

# GM+ fee in native USDC (18 decimals). Default 0.01
# NEXT_PUBLIC_GM_PLUS_FEE=0.01

# Force local mock UI (ignores live chain reads/writes)
# NEXT_PUBLIC_MOCK_MODE=true

# Optional WalletConnect / Reown project id for QR wallets
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Privy + Sign in with X (optional; wallet Connect still works without these) ---
# From https://dashboard.privy.io → your gm-arc app → App settings
# NEXT_PUBLIC_PRIVY_APP_ID=
# Optional multi-env client id (Privy App clients)
# NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Public X handle for the gm-arc account (no @). Defaults to GMARCxlm in code.
# NEXT_PUBLIC_GM_ARC_X_HANDLE=GMARCxlm

# Server-only (do NOT prefix NEXT_PUBLIC_). Only needed for Privy server APIs / webhooks later.
# PRIVY_APP_SECRET=

# X OAuth Client ID/Secret are configured in the Privy Dashboard (Login methods → Twitter/X),
# not as Next.js env vars, when using Privy's hosted OAuth callback:
#   https://auth.privy.io/api/v1/oauth/callback

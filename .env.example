# Arc mainnet ArcGM (deployed)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x605A1Adc99796C5A1AB059386EBBE533Dc9d22e3

# Optional alias for the same address
# NEXT_PUBLIC_GM_CONTRACT=0x605A1Adc99796C5A1AB059386EBBE533Dc9d22e3

# GM+ fee in native USDC (18 decimals). Default 0.01
# NEXT_PUBLIC_GM_PLUS_FEE=0.01

# Force local mock UI (ignores live chain reads/writes)
# NEXT_PUBLIC_MOCK_MODE=true

# Optional WalletConnect / Reown project id for QR wallets
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Privy + Sign in with X (optional; wallet Connect still works without these) ---
# Public Privy App ID — also set this on Vercel Production, then redeploy.
# Enable Twitter/X under Login methods in https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=cmw2ck7cw021d0fjt37otkkxs
# Optional multi-env client id (Privy App clients)
# NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Public X handle (no @). Defaults to GMARCxlm in code if unset.
# NEXT_PUBLIC_GM_ARC_X_HANDLE=GMARCxlm

# Server-only (do NOT prefix NEXT_PUBLIC_). Not required for client Sign in with X.
# Required for wallet→@handle resolution in X alerts (same app id as NEXT_PUBLIC_*).
# PRIVY_APP_ID=cmw2ck7cw021d0fjt37otkkxs
# PRIVY_APP_SECRET=

# X OAuth Client ID/Secret for *Privy login* go in the Privy Dashboard
# (Login methods → Twitter/X), not in this repo.
# Callback: https://auth.privy.io/api/v1/oauth/callback

# --- X GM / GM+ alert worker (@GMARCxlm) — see docs/x-gm-alerts.md ---
# Protects GET/POST /api/cron/x-gm-alerts (Vercel Cron sends Bearer automatically).
# CRON_SECRET=

# OAuth 1.0a user-context keys for @GMARCxlm (developer.x.com → Read and write).
# OAuth 1.0a has no scope strings; app permission must be Read and write, then
# regenerate Access Token + Secret. (OAuth 2.0 would need tweet.read tweet.write
# users.read offline.access — this worker uses OAuth 1.0a only.)
# X_API_KEY=
# X_API_KEY_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# Durable cursor + dedupe on Vercel (Upstash Redis REST). Local script uses .data/.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional indexer knobs
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# X_ALERTS_START_BLOCK=
# X_ALERTS_LOOKBACK_BLOCKS=300
# X_ALERTS_MAX_TWEETS=10
# X_ALERTS_DRY_RUN=true
